// Prisma Schema for FDA Ghana FIRMS
// Database: PostgreSQL
// Prisma Version: 7.8.0

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma.config.ts
}

// Users table
model User {
  id            String    @id @default(cuid())
  fullName      String
  companyName   String
  email         String    @unique
  password      String
  role          Role      @default(APPLICANT)
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  applications  Application[]
  sessions      Session[]
  
  @@map("users")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_PAYMENT
  DOCUMENT_VERIFICATION
  QUALITY_ASSESSMENT
  APPROVED
  REJECTED
  CANCELLED
}

enum Role {
  APPLICANT
  REVIEWER
  ADMIN
  SUPER_ADMIN
}

enum ProductCategory {
  FOOD_PRODUCTS
  PHARMACEUTICALS
  MEDICAL_DEVICES
  COSMETICS
  HOUSEHOLD_CHEMICALS
  HERBAL_PRODUCTS
  FOOD_SUPPLEMENTS
  VETERINARY_PRODUCTS
}

model Application {
  id              String            @id @default(cuid())
  applicationId   String            @unique
  productName     String
  category        ProductCategory
  status          ApplicationStatus @default(DRAFT)
  submittedDate   DateTime?
  lastUpdated     DateTime          @updatedAt
  notes           String?
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  
  @@index([userId])
  @@index([status])
  @@index([applicationId])
  @@map("applications")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  
  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}